rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /solicitacoes_contato/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.empresa is string
                    && request.resource.data.empresa.size() > 1
                    && request.resource.data.empresa.size() <= 120
                    && request.resource.data.mensagem is string
                    && request.resource.data.mensagem.size() >= 10
                    && request.resource.data.mensagem.size() <= 2000
                    && request.resource.data.status == "novo";

      allow read, update, delete: if false;
    }
  }
}